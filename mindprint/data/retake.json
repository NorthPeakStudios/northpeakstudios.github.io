read what I sent","v":{"att_anxiety":2}},{"t":"Feel a bit stupid for opening up","v":{"att_avoidance":1,"att_anxiety":1}},{"t":"Decide not to share next time","v":{"att_avoidance":2}}]},{"id":"rat5","sys":"attach","text":"Your friendships usually feel…","options":[{"t":"Steady and safe","v":{"att_anxiety":-2,"att_avoidance":-2}},{"t":"Intense, with ups and downs","v":{"att_anxiety":2}},{"t":"Easy but not that deep","v":{"att_avoidance":2}},{"t":"Close, then I pull away","v":{"att_anxiety":1,"att_avoidance":2}}]},{"id":"rat6","sys":"attach","text":"When you need help, you…","options":[{"t":"Ask someone I trust","v":{"att_avoidance":-2}},{"t":"Ask, then worry I'm a burden","v":{"att_anxiety":2}},{"t":"Handle it myself","v":{"att_avoidance":2}},{"t":"Wait for someone to notice","v":{"att_anxiety":1,"att_avoidance":1}}]},{"id":"rco1","sys":"cognitive","text":"Choosing an elective, you…","options":[{"t":"Compare all of them carefully","v":{"cg_rational":2}},{"t":"Pick the one that feels right","v":{"cg_intuitive":2}},{"t":"Ask what my friends are taking","v":{"cg_dependent":2}},{"t":"Put it off until the last day","v":{"cg_avoidant":2}}]},{"id":"rco2","sys":"cognitive","text":"Ordering food at a new place, you…","options":[{"t":"Read the whole menu","v":{"cg_rational":2}},{"t":"Point at the first thing that looks good","v":{"cg_spontaneous":2}},{"t":"Ask what's good here","v":{"cg_dependent":2}},{"t":"Go with my gut","v":{"cg_intuitive":2}}]},{"id":"rco3","sys":"cognitive","text":"Your best decisions came from…","options":[{"t":"Thinking it all through","v":{"cg_rational":2}},{"t":"A strong gut feeling","v":{"cg_intuitive":2}},{"t":"Talking it out","v":{"cg_dependent":2}},{"t":"Just going for it","v":{"cg_spontaneous":2}}]},{"id":"rco4","sys":"cognitive","text":"A big choice with no deadline. You…","options":[{"t":"Make a pros and cons list","v":{"cg_rational":2}},{"t":"Wait until it decides itself","v":{"cg_avoidant":2}},{"t":"Decide in a minute","v":{"cg_spontaneous":2}},{"t":"Sleep on it and trust my feeling","v":{"cg_intuitive":2}}]},{"id":"rco5","sys":"cognitive","text":"If a friend picks for you, you feel…","options":[{"t":"Relieved","v":{"cg_dependent":2,"cg_avoidant":1}},{"t":"Annoyed, I want to decide","v":{"cg_rational":1,"cg_spontaneous":1}},{"t":"Fine, whatever","v":{"cg_avoidant":1}},{"t":"Curious what they chose","v":{"cg_intuitive":1,"cg_dependent":1}}]},{"id":"rco6","sys":"cognitive","text":"When you change your mind, it's usually because…","options":[{"t":"New facts came in","v":{"cg_rational":2}},{"t":"Something felt off","v":{"cg_intuitive":2}},{"t":"Someone talked me out of it","v":{"cg_dependent":2}},{"t":"I got bored of the old plan","v":{"cg_spontaneous":2}}]},{"id":"rle1","sys":"learning","text":"Learning a new game, you…","options":[{"t":"Watch someone play first","v":{"ls_visual":2}},{"t":"Read the rules","v":{"ls_reading":2}},{"t":"Just start playing","v":{"ls_hands":2}},{"t":"Have a friend explain it","v":{"ls_social":2}}]},{"id":"rle2","sys":"learning","text":"The class you remember most used…","options":[{"t":"Lots of diagrams and videos","v":{"ls_visual":2}},{"t":"Good readings and notes","v":{"ls_reading":2}},{"t":"Labs and projects","v":{"ls_hands":2}},{"t":"Discussions and group work","v":{"ls_social":2}}]},{"id":"rle3","sys":"learning","text":"Directions to a new place, you'd want…","options":[{"t":"A map","v":{"ls_visual":2}},{"t":"Written steps","v":{"ls_reading":2}},{"t":"To walk it once with someone","v":{"ls_hands":1,"ls_social":1}},{"t":"Someone to tell me on the phone","v":{"ls_social":2}}]},{"id":"rle4","sys":"learning","text":"To remember a fact, you…","options":[{"t":"Picture it","v":{"ls_visual":2}},{"t":"Write it down","v":{"ls_reading":2}},{"t":"Use it right away","v":{"ls_hands":2}},{"t":"Say it out loud to someone","v":{"ls_social":2}}]},{"id":"rle5","sys":"learning","text":"Your notes look like…","options":[{"t":"Doodles, arrows and colors","v":{"ls_visual":2}},{"t":"Neat full sentences","v":{"ls_reading":2}},{"t":"Barely any, I learn by doing","v":{"ls_hands":2}},{"t":"I borrow a friend's and talk it over","v":{"ls_social":2}}]},{"id":"rle6","sys":"learning","text":"Stuck on a problem, you…","options":[{"t":"Sketch it out","v":{"ls_visual":2}},{"t":"Re-read the chapter","v":{"ls_reading":2}},{"t":"Try things until one works","v":{"ls_hands":2}},{"t":"Ask someone to explain","v":{"ls_social":2}}]},{"id":"rcl1","sys":"cluster","text":"A new hobby you'd actually try:","options":[{"t":"Something nobody I know does","v":{"O":2}},{"t":"Something my friends do","v":{"E":1,"O":-1}},{"t":"Something useful, like cooking","v":{"O":-1,"C":1}},{"t":"Nothing new, I like my stuff","v":{"O":-2}}]},{"id":"rcl2","sys":"cluster","text":"Your phone's home screen is…","options":[{"t":"Organized in folders","v":{"C":2}},{"t":"Kind of random","v":{"C":-1}},{"t":"A total mess","v":{"C":-2}},{"t":"Clean, only what I use","v":{"C":1}}]},{"id":"rcl3","sys":"cluster","text":"After a full day with people you…","options":[{"t":"Want more","v":{"E":2}},{"t":"Feel good but tired","v":{"E":0}},{"t":"Need a long break","v":{"E":-2}},{"t":"Want one more hangout with one person","v":{"E":-1}}]},{"id":"rcl4","sys":"cluster","text":"Someone cuts in line in front of you. You…","options":[{"t":"Say something right away","v":{"A":-2}},{"t":"Give them a look","v":{"A":-1}},{"t":"Let it go, not worth it","v":{"A":1}},{"t":"Assume they didn't see me","v":{"A":2}}]},{"id":"rcl5","sys":"cluster","text":"A test comes back worse than you hoped. You…","options":[{"t":"Can't stop thinking about it","v":{"N":2}},{"t":"Feel bad for a day","v":{"N":1}},{"t":"Shrug and move on","v":{"N":-2}},{"t":"Get mad, then get over it","v":{"N":1}}]},{"id":"rcl6","sys":"cluster","text":"Your ideas are usually…","options":[{"t":"Big and kind of out there","v":{"O":2}},{"t":"Practical","v":{"O":-2}},{"t":"A mix","v":{"O":0}},{"t":"Borrowed and improved","v":{"O":-1,"C":1}}]},{"id":"rcl7","sys":"cluster","tex